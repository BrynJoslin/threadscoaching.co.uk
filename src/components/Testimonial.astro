---
import type { Testimonial as TestimonialData } from '../data/testimonials';

interface Props {
  testimonial: TestimonialData;
}

const { testimonial } = Astro.props;
---

<figure class="testimonial">
  <blockquote>
    <p>“{testimonial.quote}”</p>
  </blockquote>
  {testimonial.attribution && (
    <figcaption>
      {testimonial.attribution}{testimonial.context && `, ${testimonial.context}`}
    </figcaption>
  )}
</figure>

<style>
  .testimonial {
    position: relative;
    display: grid;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    margin: 0;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: 1.5rem 1.5rem 1.5rem 0.4rem;
  }

  .testimonial::before {
    color: var(--color-coral);
    content: '“';
    font-family: Georgia, serif;
    font-size: 4rem;
    line-height: 0.45;
  }

  blockquote {
    color: var(--color-ink);
    font-size: 1.04rem;
    font-weight: 550;
    line-height: 1.62;
  }

  figcaption {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
