---
import { Image } from 'astro:assets';
import { primaryNavigation } from '../data/navigation';
import logo from '../assets/brand/threads-coaching-logo.png';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Threads Coaching home">
      <Image src={logo} alt="" width={48} height={49} quality={75} loading="eager" />
      <span class="site-header__brand-text"><strong>Threads Coaching</strong><small>Joy &amp; Paul Blundell</small></span>
    </a>

    <nav class="site-header__desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          primaryNavigation.map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="button button--primary site-header__cta" href="/contact">Start a conversation</a>

    <details class="site-header__mobile-menu">
      <summary><span class="visually-hidden">Open </span>Menu</summary>
      <nav aria-label="Mobile primary navigation">
        <ul>
          {
            primaryNavigation.map((item) => (
              <li>
                <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href="/contact">Start a conversation</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(255 253 248 / 0.9);
    border-bottom: 1px solid rgb(220 232 232 / 0.86);
    backdrop-filter: blur(16px);
  }

  .site-header__inner {
    display: flex;
    min-height: 5rem;
    align-items: center;
    gap: var(--space-4);
    justify-content: space-between;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-header__brand :global(img) {
    width: 2.75rem;
    height: 2.75rem;
  }

  .site-header__brand-text {
    display: grid;
    line-height: 1.05;
  }

  .site-header__brand-text strong {
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .site-header__brand-text small {
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .site-header__desktop-nav {
    display: none;
  }

  .site-header__desktop-nav ul,
  .site-header__mobile-menu ul {
    display: flex;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-header__desktop-nav ul {
    align-items: center;
    gap: var(--space-5);
  }

  .site-header__desktop-nav a {
    color: var(--color-ink);
    font-weight: 650;
    text-decoration: none;
  }

  @media (max-width: 27rem) {
    .site-header__brand-text small { display: none; }
  }

  .site-header__desktop-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-coral-dark);
    text-decoration-thickness: 0.15em;
    text-underline-offset: 0.35em;
  }

  .site-header__mobile-menu {
    position: relative;
  }

  .site-header__mobile-menu summary {
    min-height: 3rem;
    padding: 0.65rem 0.8rem;
    color: var(--color-ink);
    font-weight: 750;
  }

  .site-header__mobile-menu nav {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    width: min(20rem, calc(100vw - (var(--gutter) * 2)));
    padding: var(--space-3);
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  .site-header__mobile-menu ul {
    flex-direction: column;
  }

  .site-header__mobile-menu a {
    display: block;
    padding: 0.7rem;
    color: var(--color-ink);
    font-weight: 650;
  }

  .site-header__cta {
    display: none;
  }

  @media (min-width: 48rem) {
    .site-header__desktop-nav,
    .site-header__cta {
      display: block;
    }

    .site-header__mobile-menu {
      display: none;
    }
  }
</style>
