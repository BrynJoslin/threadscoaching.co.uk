---
import ButtonLink from './ButtonLink.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-card">
  {service.tag && <p class="service-card__tag">{service.tag}</p>}
  <h3>{service.title}</h3>
  <p>{service.summary ?? service.text}</p>
  {service.points && <ul>{service.points.map((point) => <li>{point}</li>)}</ul>}
  <ButtonLink href={service.href} variant="text">{service.cta ?? `Explore ${service.title}`}</ButtonLink>
</article>

<style>
  .service-card {
    position: relative;
    overflow: hidden;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: 1.8rem 1.8rem 1.8rem 0.45rem;
    box-shadow: 0 0 0 rgb(23 56 60 / 0);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .service-card::after {
    position: absolute;
    right: -2.5rem;
    bottom: -3.6rem;
    width: 9rem;
    height: 6rem;
    border: 1.3rem solid rgb(47 127 141 / 0.06);
    border-radius: 50%;
    content: '';
    transform: rotate(-18deg);
  }

  .service-card:hover {
    border-color: transparent;
    box-shadow: var(--shadow-soft);
    transform: translateY(-0.25rem);
  }

  p {
    color: var(--color-muted);
  }

  .service-card__tag {
    padding: 0.38rem 0.65rem;
    background: rgb(255 255 255 / 0.7);
    border-radius: var(--radius-pill);
    color: var(--color-teal-dark);
    font-size: var(--text-xs);
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 0.4rem;
    padding: 0;
    color: #385b60;
    list-style: none;
  }

  li::before {
    margin-right: 0.55rem;
    color: var(--color-coral-dark);
    content: '•';
    font-weight: 900;
  }

  .button {
    position: relative;
    z-index: 1;
    margin-top: auto;
  }

  :global(.home-services__grid) > .service-card:nth-child(1),
  :global(.home-services__grid) > .service-card:nth-child(5) {
    background: var(--color-teal-soft);
  }

  :global(.home-services__grid) > .service-card:nth-child(2),
  :global(.home-services__grid) > .service-card:nth-child(6) {
    background: #fff4ef;
    border-color: #f2ddd7;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card { transition: none; }
    .service-card:hover { transform: none; }
  }
</style>
