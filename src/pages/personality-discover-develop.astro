---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CallToAction from '../components/CallToAction.astro';
import joyImage from '../assets/people/joy-portrait.jpeg';
import textureImage from '../assets/services/body-soul-spirit-texture.jpg';
import { organizationSchema, serviceSchema } from '../data/schema';
---
<BaseLayout title="Personality Coaching: Discover & Develop | Threads Coaching" description="Understand your personality patterns and build a development plan that fits through personality coaching." path="/personality-discover-develop" schema={[organizationSchema, serviceSchema('Personality coaching: Discover and Develop', '/personality-discover-develop', 'Personality coaching to help people understand patterns and build a practical development plan.')] }>
  <section class="hero-copy section personality-hero"><span class="personality-hero__loop" aria-hidden="true"></span><div class="container"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Coaching', href: '/coaching' }, { label: 'Personality coaching' }]} /><div class="split split--media personality-hero__grid"><div><p class="eyebrow">Discover &amp; develop</p><h1>Understand your unique wiring—and turn insight into growth.</h1><p class="lead">Explore your personality through Jungian cognitive functions and the 16 personalities framework, then turn what you discover into a development plan that genuinely fits.</p><a class="button button--primary" href="/contact">Ask about personality coaching</a></div><div class="personality-hero__visual"><div class="personality-hero__texture" aria-hidden="true"><Image src={textureImage} alt="" width={280} quality={32} loading="eager" /></div><Image src={joyImage} alt="Joy Blundell, who leads personality coaching" width={640} densities={[1, 1.5]} sizes="(min-width: 64rem) 40vw, 88vw" quality={58} /><span class="personality-hero__dot" aria-hidden="true"></span></div></div></div></section>
  <section class="section section--tint"><div class="container narrow"><p class="eyebrow">Who this is for</p><h2>Advice works better when it starts with who you actually are.</h2><p>This is for people who want clearer language for how they process information, make decisions and relate to others—whether the questions are showing up in life, leadership or relationships.</p><p>It is a developmental coaching tool, not a clinical assessment, diagnosis or fixed label.</p></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Two ways to begin</p><h2>Choose the depth that feels useful now.</h2></div><p class="lead">Joy leads this work, helping you make sense of the framework in the context of your own life rather than treating a type as an answer in itself.</p></div><div class="card-grid personality-pathways"><article class="card"><p class="eyebrow">Discover</p><h3>Put language to your unique wiring.</h3><p>A focused one-off session explores your likely personality pattern and what it may mean for life, leadership and relationships.</p><p class="card-note">A useful place to start if you want focused insight before deciding whether you need more support.</p></article><article class="card"><p class="eyebrow">Develop</p><h3>Turn insight into practice.</h3><p>A five-session development package creates room to work with strengths, notice blind spots and practise new ways of responding.</p><p class="card-note">A more sustained route for turning insight into thoughtful choices and experiments.</p></article></div></div></section>
  <section class="section personality-process"><span class="personality-process__thread" aria-hidden="true">threads</span><div class="container"><p class="eyebrow">What happens</p><h2>From a pattern on paper to something you can use.</h2><ol class="steps"><li><strong>Start with your context.</strong><span>Bring the situations, relationships or questions that have made you curious about your personality.</span></li><li><strong>Explore your likely pattern.</strong><span>Use Jungian cognitive functions and the 16 personalities framework to name preferences, strengths and blind spots.</span></li><li><strong>Turn insight into practice.</strong><span>Choose a development plan, practical next steps or a longer pathway that fits your context.</span></li></ol></div></section>
  <section class="section"><div class="container narrow"><p class="eyebrow">What you may take from it</p><h2>Useful language, not a limiting label.</h2><ul><li>Clearer language for natural preferences and recurring patterns.</li><li>A better understanding of strengths and blind spots.</li><li>More thoughtful choices about relationships, work and development.</li><li>A plan shaped around your context, rather than a generic type label.</li></ul><p>Personality coaching can sit alongside wider <a href="/one-to-one-sessions">one-to-one coaching</a>. If you are unsure which route fits, we will talk through what you are hoping to explore and whether a Discover session, a longer development pathway or another offer is the most useful place to begin. You can also <a href="/coaching">compare the coaching routes</a>.</p></div></section>
  <section class="section section--tint"><div class="container narrow"><h2>Questions about personality coaching</h2><details><summary>Who leads personality coaching?</summary><p>Joy leads personality coaching as part of her life and leadership coaching work.</p></details><details><summary>Is this a psychological assessment?</summary><p>No. It is a developmental coaching tool, not a clinical assessment, diagnosis or fixed label.</p></details><details><summary>Can I begin with one session?</summary><p>Yes. The Discover session is designed as a focused starting point; the Develop pathway is available if deeper follow-on work feels useful.</p></details><details><summary>What will we clarify before we begin?</summary><p>We will talk through the question you want to explore, the context you are bringing and whether the focused Discover session or a longer development pathway is the better fit.</p></details></div></section>
  <CallToAction title="Get curious about what helps you thrive." body="Ask about a Discover session or a longer development pathway." primaryHref="/contact" primaryLabel="Ask about personality coaching" />
</BaseLayout>

<style>
  .personality-hero { isolation: isolate; }
  .personality-hero__grid { align-items: center; }
  .personality-hero__visual { position: relative; z-index: 1; min-height: 20rem; padding: 1rem 0 1rem 1.25rem; }
  .personality-hero__visual > :global(img) { position: relative; z-index: 2; display: block; width: min(100%, 30rem); margin-left: auto; aspect-ratio: 0.9; object-fit: cover; object-position: 50% 22%; border-radius: 58% 42% 18% 45% / 42% 48% 25% 58%; }
  .personality-hero__texture { position: absolute; z-index: 1; top: -0.5rem; left: 0; width: 46%; height: 72%; overflow: hidden; border-radius: 47% 53% 58% 42%; opacity: 0.55; transform: rotate(-12deg); }
  .personality-hero__texture :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .personality-hero__dot { position: absolute; z-index: 3; right: -0.5rem; bottom: 0.5rem; width: clamp(3rem, 8vw, 5rem); aspect-ratio: 1; background: var(--color-coral); border-radius: 43% 57% 52% 48%; transform: rotate(18deg); }
  .personality-hero__loop { position: absolute; z-index: 0; right: -8rem; bottom: 1.5rem; width: 33rem; height: 8rem; border: 2px solid rgb(47 127 141 / 0.18); border-radius: 50%; transform: rotate(12deg); }
  .personality-pathways .card { display: grid; align-content: start; gap: var(--space-4); }
  .personality-pathways .card > * { margin: 0; }
  .card-note { padding-top: var(--space-4); border-top: 1px solid rgb(23 56 60 / 0.14); color: var(--color-muted); font-size: var(--text-sm); }
  .personality-process { position: relative; overflow: hidden; background: var(--color-ink); color: var(--color-white); }
  .personality-process h2, .personality-process strong { color: inherit; }
  .personality-process .eyebrow { color: #b7dcdf; }
  .personality-process .steps li { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.16); }
  .personality-process .steps span { color: #d6e6e7; }
  .personality-process .steps li::before { color: var(--color-sand); }
  .personality-process__thread { position: absolute; right: -1rem; bottom: -6rem; color: rgb(255 255 255 / 0.04); font-family: Georgia, serif; font-size: clamp(8rem, 24vw, 18rem); font-style: italic; transform: rotate(-10deg); }
</style>
