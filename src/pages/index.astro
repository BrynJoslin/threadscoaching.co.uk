---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonial from '../components/Testimonial.astro';
import CallToAction from '../components/CallToAction.astro';
import { services } from '../data/services';
import { testimonials } from '../data/testimonials';
import heroImage from '../assets/people/joy-and-paul.jpg';
import joyPortrait from '../assets/people/joy-portrait.jpeg';
import paulPortrait from '../assets/people/paul-portrait.jpg';
import joySpeaking from '../assets/people/joy-speaking.jpg';
import strawTexture from '../assets/services/body-soul-spirit-texture.jpg';
import { organizationSchema, websiteSchema, joySchema, paulSchema } from '../data/schema';
---

<BaseLayout title="Life, Leadership & Christian Coaching | Threads Coaching" description="Warm, practical coaching for individuals and teams seeking greater clarity, confidence and purposeful change." path="/" schema={[websiteSchema, organizationSchema, joySchema, paulSchema]}>
  <section class="home-hero">
    <span class="thread-loop thread-loop--one" aria-hidden="true"></span>
    <span class="thread-loop thread-loop--two" aria-hidden="true"></span>
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">Life, leadership and Christian coaching</p>
        <h1>Find clarity. Grow with courage. <em>Bring change to your world.</em></h1>
        <p class="lead">When life, leadership or calling feels tangled, we create space to listen, notice what matters and take the next step. We coach individuals and teams who want to live and lead with purpose, wholeness and faith.</p>
        <div class="cluster">
          <a class="button button--primary" href="/contact">Start a conversation <span aria-hidden="true">→</span></a>
          <a class="button button--secondary" href="/one-to-one-sessions">Explore coaching</a>
        </div>
        <ul class="hero-points" aria-label="Key information">
          <li>Online coaching available</li>
          <li>Individuals and teams</li>
          <li>Faith-aware and practical</li>
        </ul>
      </div>

      <div class="home-hero__visual">
        <div class="hero-texture" aria-hidden="true">
          <Image src={strawTexture} alt="" width={270} quality={35} loading="eager" />
        </div>
        <div class="hero-photo-wrap">
          <Image class="hero-photo" src={heroImage} alt="Joy and Paul Blundell of Threads Coaching" width={720} densities={[1, 1.5]} sizes="(min-width: 64rem) 36rem, (min-width: 48rem) 46vw, 92vw" quality={55} loading="eager" fetchpriority="high" />
        </div>
        <aside class="hero-note">
          <strong>You don’t have to untangle it alone.</strong>
          <span>Thoughtful conversation can turn reflection into a next step that genuinely fits.</span>
        </aside>
        <span class="coral-dot" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Threads Coaching at a glance">
    <div class="container trust-strip__grid">
      <p><strong>700+ hours</strong><span>of coaching experience for Joy</span></p>
      <p><strong>Teams and organisations</strong><span>workshops and reflective practice</span></p>
      <p><strong>Faith and purpose</strong><span>integrated rather than compartmentalised</span></p>
      <p><strong>Life and leadership</strong><span>coaching for individuals</span></p>
    </div>
  </section>

  <section class="section home-problem">
    <div class="container home-problem__grid">
      <div class="home-problem__intro">
        <p class="eyebrow">When the threads feel tangled</p>
        <h2>You can be capable, committed and still not know what comes next.</h2>
        <p class="lead">Sometimes the problem is not a lack of ambition. It is that too many pressures, possibilities and expectations are pulling at once.</p>
      </div>
      <ol class="tangle-list">
        <li><div><strong>Your calling feels unclear.</strong><p>You know you want your life or work to matter, but you are struggling to discern where to focus and what to say yes to.</p></div></li>
        <li><div><strong>Leadership is costing more than it should.</strong><p>Imposter syndrome, difficult relationships, habits or unresolved pressure are getting in the way of the leader you want to become.</p></div></li>
        <li><div><strong>Your inner and outer life feel disconnected.</strong><p>Faith, body, wellbeing, identity and purpose can start to feel like separate compartments rather than one integrated life.</p></div></li>
        <li><div><strong>Your team has good intentions but lacks alignment.</strong><p>Values can remain words on a wall unless a team understands its strengths, practices and shared way of working.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section home-promise">
    <span class="promise-thread" aria-hidden="true">threads</span>
    <div class="container home-promise__grid">
      <div>
        <p class="eyebrow">Our approach</p>
        <h2>We won’t hand you a formula for somebody else’s life.</h2>
        <p class="lead">We believe good coaching helps you pay attention to who you are, what God may be inviting you into, what is getting in the way and what a faithful next step looks like. Our styles are different, but our aim is the same: honest conversation that leads to meaningful change.</p>
      </div>
      <div class="promise-cards">
        <article><h3>Clarity without prescription</h3><p>We ask questions that help you think, notice and decide rather than telling you who to become.</p></article>
        <article><h3>Faith without compartmentalising</h3><p>Where it fits you, prayer, spiritual reflection and Christian identity can be part of the conversation.</p></article>
        <article><h3>Reflection that becomes action</h3><p>Insight matters, but we also help you turn it into practical goals, experiments and next steps.</p></article>
      </div>
    </div>
  </section>

  <section class="section home-services">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Ways we can work together</p><h2>Choose the support that fits where you are.</h2></div>
        <p class="lead">You do not need to know exactly what kind of coaching you need before you contact us. Tell us what is going on and we will help you find a useful starting point.</p>
      </div>
      <div class="card-grid home-services__grid">
        {services.map((service) => <ServiceCard {service} />)}
      </div>
    </div>
  </section>

  <section class="section home-plan">
    <div class="container">
      <div class="home-plan__heading">
        <p class="eyebrow">A simple next step</p>
        <h2>You don’t have to arrive with the answer.</h2>
        <p class="lead">Our job is to help you find it. Starting is intentionally simple.</p>
      </div>
      <ol class="home-plan__steps">
        <li><h3>Tell us where you’re at</h3><p>Send us an email or give us a call. You can come with a clear goal or simply explain what feels stuck, stretched or uncertain.</p></li>
        <li><h3>Choose what fits</h3><p>We will explore whether Joy, Paul, one-to-one coaching, a team session or another offer is the right fit for what you are facing.</p></li>
        <li><h3>Move forward with clarity</h3><p>We will create space for honest reflection and practical action, so you can move towards the life, leadership or team culture you want to build.</p></li>
      </ol>
      <p class="home-plan__action"><a class="button button--primary" href="/contact">Start a conversation <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section home-guides">
    <div class="container">
      <div class="section-heading section-heading--narrow">
        <div><p class="eyebrow">Meet your coaches</p><h2>Two different approaches. One shared heart for helping people grow.</h2></div>
        <p class="lead">We are Joy and Paul, a husband-and-wife team. We each bring our own experience and coaching style, while sharing a Christian vision of people growing in courage, clarity, purpose and wholeness.</p>
      </div>

      <div class="guide guide--joy">
        <div class="guide__portrait guide__portrait--joy">
          <Image src={joyPortrait} alt="Joy Blundell, life and leadership coach" width={520} densities={[1, 1.5]} sizes="(min-width: 48rem) 24rem, 88vw" quality={58} loading="lazy" />
          <span class="guide__shape" aria-hidden="true"></span>
        </div>
        <div class="guide__copy"><p class="eyebrow">I’m Joy</p><h3>I help people lead change without losing sight of who they are.</h3><p>I am a qualified Life and Leadership Coach, pastor, organisational leader and speaker. I first experienced the power of coaching when I hit turbulent moments in my own leadership. It helped me process difficult situations, grow in confidence and find greater clarity about my calling.</p><p>I trained with Ride the Wave professional coach training in 2020 and have since gained more than 700 hours of coaching experience. Alongside coaching, I have founded Acts Trust, formed GLX and co-created Transform Lincoln, experiences that shape how I work with leaders, teams and organisations seeking meaningful change.</p><div class="credentials"><span>Qualified Life &amp; Leadership Coach</span><span>700+ coaching hours</span><span>Pastor &amp; organisational leader</span></div><a class="text-link" href="/about">Meet Joy and Paul <span aria-hidden="true">→</span></a></div>
      </div>

      <div class="guide guide--paul">
        <div class="guide__portrait guide__portrait--paul">
          <Image src={paulPortrait} alt="Paul Blundell of Threads Coaching" width={520} densities={[1, 1.5]} sizes="(min-width: 48rem) 24rem, 88vw" quality={52} loading="lazy" />
          <span class="guide__shape" aria-hidden="true"></span>
        </div>
        <div class="guide__copy"><p class="eyebrow">I’m Paul</p><h3>I help people pursue identity, purpose and wholeness with God at the centre.</h3><p>I am a pastor and coach, and I am passionate about people knowing God and living from their identity as image bearers. My coaching grows out of my own journey of healing and breakthrough across body, mind and spirit.</p><p>I am currently training in Breakthrough Life Coaching. I bring a pastoral, faith-filled approach that can include powerful questions, inner-healing tools, prayer and practical goal setting. My aim is not simply the absence of struggle, but a deeper experience of shalom, peace, purpose and alignment.</p><div class="credentials"><span>Pastor &amp; teacher</span><span>Breakthrough Life Coaching training</span><span>Body, soul &amp; spirit focus</span></div><a class="text-link" href="/body-soul-spirit-reset">Explore Paul’s coaching <span aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <section class="section home-teams">
    <span class="team-thread" aria-hidden="true"></span>
    <div class="container home-teams__grid">
      <div><p class="eyebrow">For teams and organisations</p><h2>Turn your ethos into the way your team actually works.</h2><p class="lead">Healthy culture takes more than a mission statement. We help teams clarify what they value, understand how people contribute and create practices that support both effectiveness and wellbeing.</p><a class="button button--primary" href="/team-workshops">Talk to us about your team <span aria-hidden="true">→</span></a></div>
      <div class="team-cards">
        <article><h3>Group and team coaching</h3><p>Reflective practice and deeper connection, particularly relevant in health, social care and pastoral settings where work carries both professional and human complexity.</p></article>
        <article><h3>Discover your team’s Working Genius</h3><p>Explore the Working Genius framework and identify how different strengths can contribute more effectively across the life of your team.</p></article>
        <article><h3>Organisational values curation</h3><p>Clarify the values that genuinely guide your team, then bridge the gap between what you say matters and how you lead, decide and work together.</p></article>
      </div>
    </div>
  </section>

  <section class="section home-testimonials">
    <div class="container">
      <div class="section-heading section-heading--narrow"><div><p class="eyebrow">What coaching can unlock</p><h2>Clarity is valuable because it changes what you do next.</h2></div></div>
      <div class="testimonial-grid">{testimonials.map((testimonial) => <Testimonial {testimonial} />)}</div>
    </div>
  </section>

  <section class="section home-speaking">
    <div class="container home-speaking__grid">
      <div class="home-speaking__copy"><p class="eyebrow">Speaking and preaching</p><h2>Need a communicator who can move people from inspiration to action?</h2><p class="lead">We believe communication can do more than fill a programme slot. Joy is an experienced communicator who regularly speaks to groups ranging from small gatherings to audiences in the thousands, drawing from Scripture and applied Christian teaching to mobilise people towards mission and meaningful change.</p><p>For events, podcasts, conferences or discussion panels, get in touch and tell us what you want your audience to think, feel and do differently.</p><a class="button button--primary" href="/public-speaking">Enquire about speaking <span aria-hidden="true">→</span></a></div>
      <div class="speaking-photo-wrap">
        <Image src={joySpeaking} alt="Joy Blundell speaking at an event" width={620} densities={[1, 1.5]} sizes="(min-width: 48rem) 38vw, 88vw" quality={58} loading="lazy" />
        <span class="speaking-scribble" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="section home-faq">
    <div class="container home-faq__grid">
      <div><p class="eyebrow">Questions</p><h2>Before we talk</h2><p class="lead">You do not need to have everything figured out first.</p></div>
      <div>
        <details open><summary>Do I need to be a Christian to work with you?</summary><p>Our coaching is shaped by a Christian understanding of identity, purpose and wholeness, and some of our offers explicitly include prayer, spiritual direction or discernment. If you are unsure whether that fits what you are looking for, send us a message and we can talk it through.</p></details>
        <details><summary>How do I know whether Joy or Paul is the right coach for me?</summary><p>You do not need to choose before getting in touch. Joy particularly focuses on life and leadership coaching, calling, organisational development and personality. Paul particularly focuses on identity, discipleship and holistic body-soul-spirit coaching. Tell us what you are hoping to work on and we will help you find the best fit.</p></details>
        <details><summary>Can we work together online?</summary><p>Yes. Online coaching is available, so location does not have to be a barrier.</p></details>
        <details><summary>Do you work with whole teams as well as individuals?</summary><p>Yes. We offer team and group coaching, Working Genius workshops and organisational values work, with particular experience across church, public and third-sector contexts.</p></details>
        <details><summary>What if I am not sure exactly what my goal is?</summary><p>That is completely workable. Clarity is often one of the things coaching helps create. You can begin by telling us what feels stuck, unclear or important, and we can start from there.</p></details>
      </div>
    </div>
  </section>

  <CallToAction title="What’s the thread you want to pick up next?" body="Whether you are navigating a transition, developing as a leader or helping a team become more aligned, start by telling us what is going on." primaryHref="/contact" primaryLabel="Start a conversation" secondaryHref="tel:+447739353444" secondaryLabel="Call 07739 353444" />
</BaseLayout>

<style>
  .home-hero { position: relative; overflow: hidden; padding-block: clamp(3rem, 7vw, 6rem); background: radial-gradient(circle at 12% 13%, rgb(229 223 189 / 0.72), transparent 23rem), linear-gradient(135deg, #fffdf8 0%, #f5fbfa 48%, var(--color-teal-soft) 100%); }
  .home-hero__grid { position: relative; z-index: 2; display: grid; gap: clamp(3rem, 6vw, 5rem); align-items: center; }
  .home-hero__copy { display: grid; gap: var(--space-5); }
  .home-hero h1 em { display: block; color: var(--color-teal); font-style: normal; }
  .home-hero__visual { position: relative; min-height: clamp(29rem, 64vw, 39rem); }
  .hero-photo-wrap { position: absolute; z-index: 2; top: 0; right: 0; width: min(88%, 31rem); height: min(88vw, 37rem); max-height: 37rem; overflow: hidden; border: 0.45rem solid rgb(255 255 255 / 0.78); border-radius: 48% 48% 8% 8% / 35% 35% 7% 7%; box-shadow: 0 1.5rem 4rem rgb(23 56 60 / 0.18); }
  .hero-photo-wrap :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 55% 66%; transform: scale(1.04); }
  .hero-texture { position: absolute; z-index: 1; top: 3rem; left: 0; width: 41%; height: 68%; overflow: hidden; border-radius: 52% 48% 40% 60% / 48% 36% 64% 52%; opacity: 0.62; transform: rotate(-8deg); }
  .hero-texture :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero-note { position: absolute; z-index: 3; right: 5%; bottom: 0; width: min(82%, 19rem); padding: 1.25rem 1.4rem; background: rgb(255 255 255 / 0.96); border: 1px solid var(--color-line); border-radius: 1.3rem; box-shadow: var(--shadow-soft); transform: rotate(1.5deg); }
  .hero-note strong, .hero-note span { display: block; }
  .hero-note strong { margin-bottom: 0.25rem; font-size: 1.08rem; }
  .hero-note span { color: var(--color-muted); font-size: var(--text-sm); }
  .coral-dot { position: absolute; z-index: 3; top: 8%; right: -0.5rem; width: clamp(3.5rem, 9vw, 5.5rem); aspect-ratio: 1; background: var(--color-coral); border-radius: 50%; mix-blend-mode: multiply; }
  .thread-loop { position: absolute; z-index: 1; width: 32rem; height: 9rem; border: 2px solid rgb(47 127 141 / 0.24); border-radius: 50%; pointer-events: none; }
  .thread-loop--one { top: 5rem; right: -8rem; transform: rotate(-14deg); }
  .thread-loop--two { top: 9rem; right: -10rem; transform: rotate(9deg); }
  .hero-points { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; padding: 0; color: var(--color-muted); font-size: var(--text-sm); font-weight: 700; list-style: none; }
  .hero-points li { display: flex; gap: 0.45rem; align-items: center; }
  .hero-points li::before { display: grid; width: 1.25rem; aspect-ratio: 1; place-items: center; background: var(--color-teal-soft); border-radius: 50%; color: var(--color-teal-dark); content: '✓'; font-size: 0.7rem; }

  .trust-strip { background: var(--color-white); border-block: 1px solid var(--color-line); }
  .trust-strip__grid { display: grid; }
  .trust-strip p { display: grid; max-width: none; gap: 0.1rem; padding: 1.25rem; border-bottom: 1px solid var(--color-line); }
  .trust-strip p:last-child { border-bottom: 0; }
  .trust-strip strong { color: var(--color-teal-dark); }
  .trust-strip span { color: var(--color-muted); font-size: var(--text-sm); }

  .home-problem { background: var(--color-white); }
  .home-problem__grid { display: grid; gap: clamp(2.5rem, 7vw, 5rem); }
  .home-problem__intro { display: grid; gap: var(--space-5); align-content: start; }
  .tangle-list { display: grid; gap: 0; padding: 0; list-style: none; counter-reset: tangles; }
  .tangle-list li { display: grid; grid-template-columns: 3rem 1fr; gap: var(--space-4); max-width: none; padding-block: 1.3rem; border-bottom: 1px solid var(--color-line); counter-increment: tangles; }
  .tangle-list li::before { display: grid; width: 2.6rem; aspect-ratio: 1; place-items: center; background: var(--color-teal-soft); border-radius: 34% 66% 58% 42% / 47% 42% 58% 53%; color: var(--color-teal-dark); content: '0' counter(tangles); font-size: var(--text-sm); font-weight: 800; }
  .tangle-list strong { display: block; margin-bottom: 0.25rem; }
  .tangle-list p { color: var(--color-muted); }

  .home-promise { position: relative; overflow: hidden; background: var(--color-ink); color: var(--color-white); }
  .home-promise h2, .home-promise h3 { color: inherit; }
  .home-promise .eyebrow { color: #b7dcdf; }
  .home-promise .lead { margin-top: var(--space-5); color: #c8d9da; }
  .home-promise__grid { position: relative; z-index: 2; display: grid; gap: clamp(2.5rem, 7vw, 5rem); align-items: center; }
  .promise-cards { display: grid; gap: var(--space-3); }
  .promise-cards article { padding: 1.2rem 1.3rem; background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.14); border-radius: var(--radius-md); }
  .promise-cards h3 { margin-bottom: 0.25rem; font-size: 1.15rem; }
  .promise-cards p { color: #cadadb; }
  .promise-thread { position: absolute; right: -2rem; bottom: -7rem; color: rgb(255 255 255 / 0.035); font-family: Georgia, serif; font-size: clamp(8rem, 25vw, 19rem); font-style: italic; transform: rotate(-9deg); }

  .home-services { background: #fffdf9; }
  .section-heading { display: grid; gap: var(--space-5); margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .section-heading > div { display: grid; gap: var(--space-4); }
  .home-services__grid { gap: var(--space-5); }

  .home-plan { background: var(--color-cream); }
  .home-plan__heading { display: grid; max-width: 48rem; gap: var(--space-4); margin: 0 auto clamp(2.25rem, 6vw, 4rem); text-align: center; justify-items: center; }
  .home-plan__steps { display: grid; gap: var(--space-4); padding: 0; list-style: none; counter-reset: plan; }
  .home-plan__steps li { max-width: none; padding: var(--space-6); background: var(--color-white); border: 1px solid #ece7d8; border-radius: 1.5rem 1.5rem 1.5rem 0.35rem; counter-increment: plan; }
  .home-plan__steps li::before { display: block; margin-bottom: 2rem; color: var(--color-coral-dark); content: '0' counter(plan); font-size: var(--text-sm); font-weight: 850; letter-spacing: 0.1em; }
  .home-plan__steps h3 { margin-bottom: 0.5rem; }
  .home-plan__steps p { color: var(--color-muted); }
  .home-plan__action { max-width: none; margin-top: var(--space-6); text-align: center; }

  .home-guides { overflow: hidden; background: var(--color-white); }
  .section-heading--narrow { max-width: 52rem; }
  .guide { display: grid; gap: clamp(2rem, 7vw, 4rem); align-items: center; padding-block: clamp(2.25rem, 6vw, 4rem); border-top: 1px solid var(--color-line); }
  .guide__portrait { position: relative; width: min(88vw, 25rem); aspect-ratio: 1; }
  .guide__portrait :global(img) { position: relative; z-index: 2; width: 100%; height: 100%; object-fit: cover; }
  .guide__portrait--joy :global(img) { border-radius: 43% 57% 52% 48% / 48% 42% 58% 52%; }
  .guide__portrait--paul :global(img) { border-radius: 58% 42% 46% 54% / 42% 54% 46% 58%; object-position: 50% 24%; }
  .guide__shape { position: absolute; z-index: 1; width: 58%; aspect-ratio: 1; border-radius: 50%; }
  .guide__portrait--joy .guide__shape { right: -13%; bottom: -8%; background: var(--color-sand); }
  .guide__portrait--paul .guide__shape { top: -8%; left: -12%; background: var(--color-coral); }
  .guide__copy { display: grid; gap: var(--space-4); }
  .guide__copy h3 { font-size: clamp(1.75rem, 3.2vw, 2.75rem); }
  .guide__copy p:not(.eyebrow) { color: var(--color-muted); }
  .credentials { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .credentials span { padding: 0.42rem 0.7rem; background: var(--color-teal-soft); border-radius: var(--radius-pill); color: var(--color-teal-dark); font-size: var(--text-xs); font-weight: 750; }

  .home-teams { position: relative; overflow: hidden; background: linear-gradient(140deg, var(--color-teal-dark), var(--color-teal)); color: var(--color-white); }
  .home-teams h2, .home-teams h3 { color: inherit; }
  .home-teams .eyebrow { color: #c9e7e9; }
  .home-teams .lead { margin-block: var(--space-5); color: #e0eff0; }
  .home-teams__grid { position: relative; z-index: 2; display: grid; gap: clamp(2.5rem, 7vw, 5rem); align-items: start; }
  .team-cards { display: grid; gap: var(--space-3); }
  .team-cards article { padding: 1.25rem 1.4rem; background: rgb(255 255 255 / 0.09); border: 1px solid rgb(255 255 255 / 0.15); border-radius: 1.2rem 1.2rem 1.2rem 0.25rem; backdrop-filter: blur(3px); }
  .team-cards h3 { margin-bottom: 0.3rem; font-size: 1.15rem; }
  .team-cards p { color: #d9ebec; }
  .team-thread { position: absolute; right: -8rem; bottom: -5rem; width: 31rem; height: 13rem; border: 3.5rem solid rgb(255 255 255 / 0.055); border-radius: 50%; transform: rotate(-12deg); }

  .home-testimonials { background: #f7faf9; }
  .testimonial-grid { display: grid; gap: var(--space-4); }

  .home-speaking { overflow: hidden; background: #fffaf6; }
  .home-speaking__grid { display: grid; gap: clamp(2.5rem, 7vw, 5rem); align-items: center; }
  .home-speaking__copy { display: grid; gap: var(--space-5); }
  .speaking-photo-wrap { position: relative; width: min(100%, 35rem); }
  .speaking-photo-wrap :global(img) { position: relative; z-index: 2; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 25%; border-radius: 2.5rem 2.5rem 0.6rem 2.5rem; box-shadow: var(--shadow-soft); }
  .speaking-scribble { position: absolute; z-index: 1; right: -6%; bottom: -10%; width: 52%; aspect-ratio: 1; background: var(--color-sand); border-radius: 38% 62% 51% 49% / 58% 42% 58% 42%; transform: rotate(15deg); }

  .home-faq { background: var(--color-cream); }
  .home-faq__grid { display: grid; gap: clamp(2.5rem, 7vw, 5rem); }
