---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import contactImage from '../assets/people/joy-contact.jpg';
import { organizationSchema, websiteSchema, pageSchema } from '../data/schema';
---
<BaseLayout title="Contact Threads Coaching" description="Start a conversation with Threads Coaching about one-to-one coaching, teams, speaking or finding the right support." path="/contact" schema={[organizationSchema, websiteSchema, pageSchema('ContactPage', '/contact', 'Contact Threads Coaching')] }>
  <section class="hero-copy section"><div class="container"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} /><div class="split split--media"><div><p class="eyebrow">Your next step</p><h1>What’s the thread you want to pick up next?</h1><p class="lead">Whether you are navigating a transition, discerning your calling, developing as a leader, pursuing greater wholeness or helping a team become more aligned, we would love to hear what is going on.</p><p>You can come with a clear goal or simply explain what feels stuck, stretched or uncertain.</p><address><p><a href="mailto:threadscoaching@gmail.com">threadscoaching@gmail.com</a></p><p><a href="tel:+447739353444">+44 7739 353444</a></p></address></div><Image src={contactImage} alt="Joy from Threads Coaching" width={640} densities={[1, 1.5]} sizes="(min-width: 64rem) 45vw, 100vw" quality={60} /></div></div></section>
  <section class="section section--plan"><div class="container"><h2>What happens next</h2><ol class="steps"><li><strong>Get in touch.</strong><span>Email or call with a little context.</span></li><li><strong>Find the right fit.</strong><span>We will help you identify the most useful next conversation.</span></li><li><strong>Decide your next step.</strong><span>There is no need to have it all worked out beforehand.</span></li></ol></div></section>
  <section class="section"><div class="container narrow"><h2>Prepare your enquiry</h2><EnquiryForm mode="placeholder" /></div></section>
</BaseLayout>
